{
  "server": { "host": "127.0.0.1", "port": 8103 },
  "local": {
    "base_url": "http://127.0.0.1:8096/v1",
    "model": "local",
    "api_key": "k",
    "timeout": 5
  },
  "clouds": [
    { "name": "fakeA", "base_url": "http://127.0.0.1:8098/v1",
      "model": "fakeA-model", "api_key": "k", "timeout": 10, "enabled": true }
  ],
  "router": {
    "enabled": true,
    "cloud_prefix": "[via:{name}({model})] ",
    "fallback_on": {
      "timeout": true, "connection_error": true, "http_5xx": true, "http_429": true,
      "http_401": true, "http_402": true, "http_403": true, "context_overflow": true,
      "http_4xx": false
    },
    "chat_route_enabled": true,
    "chat_route_debug": false,
    "local_health": { "enabled": true, "interval": 3, "cooldown": 20 },
    "circuit_breaker": { "enabled": true, "threshold": 2, "cool_down": 20 },
    "smart_route": { "enabled": false },
    "prefer_local": true
  },
  "log": { "level": "info", "file": "logs/test_probe.log" }
}
